// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Listing {
  id            String    @id @default(cuid())

  title         String
  description   String
  url           String    @unique
  handle        String?   // For @handles like Twitter
  category      Category  @default(Other)
  platform      String    @default("website") // "website" | "twitter" | "facebook" | "instagram" | "tiktok"

  totalVotes    Int       @default(0)  // All-time vote count
  dayVotes      Int       @default(0)  // Today (rolling 24h) vote count
  clickCount    Int       @default(0)

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  votes         Vote[]
  dailySnapshots DailyVoteSnapshot[]

  @@index([category])
  @@index([totalVotes])
  @@index([dayVotes])
  @@index([createdAt])
  @@map("listings")
}

model Vote {
  id        String   @id @default(cuid())
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)

  voterId   String   // Anonymous voter ID (session-based)
  votedAt   DateTime @default(now())

  @@unique([listingId, voterId])  // One vote per voter per listing
  @@index([listingId])
  @@index([voterId])
  @@map("votes")
}

model DailyVoteSnapshot {
  id        String   @id @default(cuid())
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)

  date      DateTime // UTC date (midnight)
  votes     Int      // Vote count for that day

  createdAt DateTime @default(now())

  @@unique([listingId, date])
  @@index([date])
  @@map("daily_vote_snapshots")
}

model DailySnapshot {
  id        String   @id @default(cuid())
  date      DateTime @unique // UTC date (midnight)

  // Snapshot of top 10 for that day (for archiving/historical pages)
  data      Json     // Array of { listing, rank, amount }

  frozen    Boolean  @default(false) // Once midnight passes, snapshot freezes
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([date])
  @@map("daily_snapshots")
}

enum Category {
  All
  Technology  // ٹیکنالوجی
  ECommerce   // ای کامرس
  DigitalMarketing // ڈیجیٹل مارکیٹنگ
  Education   // تعلیم
  Health      // صحت
  Fashion     // فیشن
  Food        // کھانا
  Travel      // سفر
  Business    // بزنس
  Other       // دیگر
}
