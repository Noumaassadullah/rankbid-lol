// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Listing {
  id            String    @id @default(cuid())

  title         String
  description   String
  url           String    @unique
  handle        String?   // For @handles like Twitter
  category      Category  @default(Other)
  platform      String    @default("website") // "website" | "twitter" | "facebook" | "instagram" | "tiktok"

  totalPaid     Int       @default(0)  // All-time sum in cents
  dayPaid       Int       @default(0)  // Today (rolling 24h) in cents
  clickCount    Int       @default(0)

  createdAt     DateTime  @default(now())
  lastRaisedAt  DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  payments      Payment[]
  dailyRanks    DailyRank[]

  @@index([category])
  @@index([totalPaid])
  @@index([dayPaid])
  @@index([createdAt])
  @@map("listings")
}

model Payment {
  id                String   @id @default(cuid())
  listingId         String
  listing           Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)

  amount            Int      // in cents
  bidType           String   @default("alltime") // "alltime" | "daily"
  provider          String   @default("jazzcash") // "jazzcash" | "stripe"
  status            String   @default("pending") // "pending" | "completed" | "failed"

  transactionId     String?  @unique // JazzCash pp_txn_ref or Stripe transaction ID
  stripeSessionId   String?  @unique // Legacy Stripe field
  stripePaymentId   String?  @unique // Legacy Stripe field

  metadata          Json?    // Provider-specific data (response codes, auth codes, etc.)

  paidAt            DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([listingId])
  @@index([status])
  @@index([transactionId])
  @@index([provider])
  @@index([bidType])
  @@map("payments")
}

model DailyRank {
  id        String   @id @default(cuid())
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)

  date      DateTime // UTC date (midnight)
  amount    Int      // Amount paid that day in cents

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([listingId, date])
  @@index([date])
  @@map("daily_ranks")
}

model DailySnapshot {
  id        String   @id @default(cuid())
  date      DateTime @unique // UTC date (midnight)

  // Snapshot of top 10 for that day (for archiving/historical pages)
  data      Json     // Array of { listing, rank, amount }

  frozen    Boolean  @default(false) // Once midnight passes, snapshot freezes
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([date])
  @@map("daily_snapshots")
}

enum Category {
  All
  Technology  // ٹیکنالوجی
  ECommerce   // ای کامرس
  DigitalMarketing // ڈیجیٹل مارکیٹنگ
  Education   // تعلیم
  Health      // صحت
  Fashion     // فیشن
  Food        // کھانا
  Travel      // سفر
  Business    // بزنس
  Other       // دیگر
}
